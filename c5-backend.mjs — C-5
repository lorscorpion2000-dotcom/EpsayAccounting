// c5-backend.mjs — C-5: Budget control for Purchase Order approval
import fs from 'node:fs';
import path from 'node:path';

const ROOT = 'E:\\EpsayAccounting\\backend\\src\\modules\\approvals';

const read  = (p) => fs.readFileSync(p, 'utf8');
const write = (p, s) => fs.writeFileSync(p, s, 'utf8');

function replaceOnce(text, from, to, label) {
  const i = text.indexOf(from);
  if (i === -1) throw new Error(`❌ Not found: ${label}`);
  if (text.indexOf(from, i + 1) !== -1) throw new Error(`⚠️ Multiple matches: ${label}`);
  return text.slice(0, i) + to + text.slice(i + from.length);
}

// ============ 1) DTO ============
const dtoPath = path.join(ROOT, 'dto', 'approve.dto.ts');
let dto = read(dtoPath);
dto = replaceOnce(
  dto,
  `import { IsString, IsOptional } from 'class-validator';`,
  `import { IsString, IsOptional, IsBoolean } from 'class-validator';`,
  'dto import',
);
dto = replaceOnce(
  dto,
  `  @IsOptional()\r\n  @IsString()\r\n  note?: string;\r\n}`,
  `  @IsOptional()\r\n  @IsString()\r\n  note?: string;\r\n\r\n  @ApiPropertyOptional({ description: 'Ignore budget warning (only for purchase-order)' })\r\n  @IsOptional()\r\n  @IsBoolean()\r\n  force?: boolean;\r\n}`,
  'dto force field (CRLF)',
).replace(/^❌/,'') // no-op safeguard
  ;
write(dtoPath, dto);
console.log('✅ DTO updated');

// ============ 2) Controller ============
const ctrlPath = path.join(ROOT, 'approvals.controller.ts');
let ctrl = read(ctrlPath);
ctrl = replaceOnce(
  ctrl,
  `return this.service.approve(dto.module, dto.id, userId);`,
  `return this.service.approve(dto.module, dto.id, userId, dto.force);`,
  'controller approve call',
);
write(ctrlPath, ctrl);
console.log('✅ Controller updated');

// ============ 3) Service ============
const svcPath = path.join(ROOT, 'approvals.service.ts');
let svc = read(svcPath);

svc = replaceOnce(
  svc,
  `import { Injectable, NotFoundException } from '@nestjs/common';`,
  `import { Injectable, NotFoundException, BadRequestException } from '@nestjs/common';`,
  'service import',
);

svc = replaceOnce(
  svc,
  `  async approve(module: string, id: string, userId: string) {`,
  `  async approve(module: string, id: string, userId: string, force?: boolean) {`,
  'service signature',
);

svc = replaceOnce(
  svc,
  `      case 'purchase-order':\r\n        return this.prisma.purchaseOrder.update({\r\n          where: { id },\r\n          data: { status: 'APPROVED' },\r\n        });`,
  `      case 'purchase-order':\r\n        return this.approvePurchaseOrderWithBudgetCheck(id, userId, force);`,
  'purchase-order case (CRLF)',
);

const lastClose = svc.lastIndexOf('\n}');
if (lastClose === -1) throw new Error('❌ Closing brace not found');

const newMethod = `

  // ============================================================
  // C-5: Budget control for Purchase Order approval
  // ============================================================
  private async approvePurchaseOrderWithBudgetCheck(
    poId: string,
    userId: string,
    force?: boolean,
  ) {
    const check = await this.checkBudgetForPurchaseOrder(poId);
    if (check && check.exceeded && !force) {
      throw new BadRequestException({
        code: 'BUDGET_EXCEEDED',
        message: 'Budget threshold exceeded. Send force=true to approve anyway.',
        detail: check,
      });
    }
    return this.prisma.purchaseOrder.update({
      where: { id: poId },
      data: { status: 'APPROVED' },
    });
  }

  // C-5: Compute budget status for a PO based on its PR's WBS item
  async checkBudgetForPurchaseOrder(poId: string) {
    const po = await this.prisma.purchaseOrder.findUnique({
      where: { id: poId },
      include: { pr: { select: { wbsItemId: true } } },
    });
    if (!po) throw new NotFoundException('PO not found');
    if (!po.pr?.wbsItemId) return null;

    const wbsItemId = po.pr.wbsItemId;

    const budgetAgg = await this.prisma.projectBudget.aggregate({
      where: { wbsItemId, projectId: po.projectId },
      _sum: { amount: true },
    });
    const budget = Number(budgetAgg._sum.amount || 0);
    if (budget <= 0) return null;

    const committedAgg = await this.prisma.purchaseOrder.aggregate({
      where: {
        status: 'APPROVED',
        id: { not: poId },
        pr: { wbsItemId },
      },
      _sum: { totalAmount: true },
    });
    const committed = Number(committedAgg._sum.totalAmount || 0);

    const actualAgg = await this.prisma.purchaseInvoiceItem.aggregate({
      where: {
        wbsItemId,
        invoice: { status: { notIn: ['DRAFT', 'CANCELLED'] } },
      },
      _sum: { totalPrice: true },
    });
    const actual = Number(actualAgg._sum.totalPrice || 0);

    const currentPO = Number(po.totalAmount);
    const projectedTotal = committed + actual + currentPO;
    const thresholdPercent = 10;
    const threshold = budget * (1 + thresholdPercent / 100);
    const exceeded = projectedTotal > threshold;

    return {
      wbsItemId,
      budget,
      committed,
      actual,
      currentPO,
      projectedTotal,
      threshold,
      thresholdPercent,
      exceeded,
      overBudget: exceeded ? projectedTotal - budget : 0,
    };
  }`;

svc = svc.slice(0, lastClose) + newMethod + svc.slice(lastClose);
write(svcPath, svc);
console.log('✅ Service updated');
console.log('🎉 Done. Now: cd backend && npm run build');