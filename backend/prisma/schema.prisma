// ═══════════════════════════════════════════════════════════════
//  ماول قراردادها (Legal Contracts)
// ═══════════════════════════════════════════════════════════════

enum LegalContractKind {
  WORKER_EMPLOYMENT
  CONTRACTOR_AGREEMENT
  CLIENT_CONTRACT
  SUBCONTRACTOR
}

enum LegalContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
  TERMINATED
}

enum LegalContractPartyKind {
  INDIVIDUAL
  COMPANY
}

model LegalContractParty {
  id                 String                 @id @default(cuid())
  kind               LegalContractPartyKind @default(INDIVIDUAL)
  fullName           String
  fatherName         String?
  nationalId         String?                @unique
  economicCode       String?
  registrationNumber String?
  birthDate          DateTime?
  mobilePhone        String?
  landlinePhone      String?
  email              String?
  maritalStatus      MaritalStatus?
  childrenCount      Int?
  education          String?
  job                String?
  insuranceNumber    String?
  address            String?                @db.Text
  postalCode         String?
  bankName           String?
  bankAccount        String?
  bankSheba          String?
  notes              String?                @db.Text

  contracts LegalContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([fullName])
  @@index([nationalId])
}

model LegalContract {
  id     String              @id @default(cuid())
  code   String              @unique
  kind   LegalContractKind
  status LegalContractStatus @default(DRAFT)

  registrationNumber String?
  registrationDate   DateTime?

  partyId String
  party   LegalContractParty @relation(fields: [partyId], references: [id])

  projectId String?  @db.Uuid
  project   Project? @relation("ProjectLegalContracts", fields: [projectId], references: [id])

  title    String
  subject  String? @db.Text
  bodyHtml String? @db.Text

  totalAmount      Decimal? @db.Decimal(18, 0)
  salaryMonthly    Decimal? @db.Decimal(18, 0)
  salaryDaily      Decimal? @db.Decimal(18, 0)
  salaryHourly     Decimal? @db.Decimal(18, 0)
  workHoursPerWeek Int?

  // B15.6: تفکیک مزایا و کسورات حقوق (پیوست ۱ قرارداد کارگری)
  wageBreakdown Json?

  startDate    DateTime?
  endDate      DateTime?
  durationText String?
  workLocation String?

  guaranteeType   String?
  guaranteeNumber String?
  guaranteeAmount Decimal? @db.Decimal(18, 0)
  guaranteeBank   String?

  supervisorName    String?
  companySignerName String?
  workerSignerName  String?

  notes String? @db.Text

  cancellationReason String?   @db.Text
  cancelledAt        DateTime?
  cancelledById      String?

  attachments          LegalContractAttachment[]
  items                LegalContractItem[]
  workerStatements     SubcontractorStatement[]  @relation("WorkerStatementContract")
  workerStatementsLink WorkerStatement[]         @relation("WorkerStatementContractLink")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([code])
  @@index([kind])
  @@index([status])
  @@index([partyId])
  @@index([projectId])
  @@index([deletedAt])
}

model LegalContractAttachment {
  id         String        @id @default(cuid())
  contractId String
  contract   LegalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime      @default(now())

  @@index([contractId])
}

model LegalContractItem {
  id         String        @id @default(cuid())
  contractId String
  contract   LegalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  rowNumber   Int
  description String
  unit        String?
  quantity    Decimal @db.Decimal(20, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(20, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(24, 2)
  notes       String?

  createdAt DateTime @default(now())

  @@index([contractId])
}

model LegalContractTemplate {
  id        String            @id @default(cuid())
  kind      LegalContractKind @unique
  title     String
  bodyHtml  String            @db.Text
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// ═══════════════════════════════════════════════════════════════
//  ماول فروش و پیشفروش (Sales)
// ═══════════════════════════════════════════════════════════════

enum SalesUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  CANCELLED
}

enum SalesPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model SalesUnit {
  id        String  @id @default(cuid())
  projectId String  @db.Uuid
  project   Project @relation("ProjectSalesUnits", fields: [projectId], references: [id])

  unitNumber   String
  block        String?
  floor        Int?
  area         Decimal?        @db.Decimal(10, 2)
  bedrooms     Int?
  parkingCount Int?
  storageCount Int?
  listPrice    Decimal?        @db.Decimal(18, 0)
  status       SalesUnitStatus @default(AVAILABLE)
  notes        String?         @db.Text

  salesContracts SalesContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@unique([projectId, unitNumber, block])
  @@index([projectId])
  @@index([status])
}

model SalesCustomer {
  id            String  @id @default(cuid())
  fullName      String
  nationalId    String? @unique
  mobilePhone   String?
  landlinePhone String?
  email         String?
  address       String? @db.Text
  postalCode    String?
  bankSheba     String?
  notes         String? @db.Text
  isActive      Boolean @default(true)

  salesContracts SalesContract[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  salesInvoices SalesInvoice[] @relation("SIFromCustomer")
  salesReceipts SalesReceipt[] @relation("SRFromCustomer")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([fullName])
}

model SalesContract {
  id     String              @id @default(cuid())
  code   String              @unique
  status LegalContractStatus @default(DRAFT)

  unitId String
  unit   SalesUnit? @relation(fields: [unitId], references: [id])

  customerId String
  customer   SalesCustomer @relation(fields: [customerId], references: [id])

  totalPrice     Decimal  @db.Decimal(18, 0)
  discountAmount Decimal? @db.Decimal(18, 0)
  finalPrice     Decimal  @db.Decimal(18, 0)
  downPayment    Decimal? @db.Decimal(18, 0)

  contractDate DateTime
  deliveryDate DateTime?

  bodyHtml String? @db.Text
  notes    String? @db.Text

  cancellationReason String?   @db.Text
  cancelledAt        DateTime?

  installments SalesInstallment[]
  payments     SalesPayment[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  salesInvoices SalesInvoice[] @relation("SIFromContract")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([code])
  @@index([status])
  @@index([customerId])
  @@index([unitId])
}

model SalesInstallment {
  id         String        @id @default(cuid())
  contractId String
  contract   SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  sequence   Int
  dueDate    DateTime
  amount     Decimal            @db.Decimal(18, 0)
  paidAmount Decimal            @default(0) @db.Decimal(18, 0)
  status     SalesPaymentStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
}

model SalesPayment {
  id         String        @id @default(cuid())
  contractId String
  contract   SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  amount          Decimal  @db.Decimal(18, 0)
  paidAt          DateTime
  paymentMethod   String?
  referenceNumber String?
  bankName        String?
  notes           String?  @db.Text

  createdAt DateTime @default(now())

  @@index([contractId])
  @@index([paidAt])
}

// ═══════════════════════════════════════════════════════════════
//  پیوست‌های عمومی (چند فایل برای هر entity)
// ═══════════════════════════════════════════════════════════════

model Attachment {
  id         String @id @default(uuid()) @db.Uuid
  entityType String @map("entity_type") @db.VarChar(32)
  entityId   String @map("entity_id") @db.VarChar(64)

  filename    String  @db.VarChar(255)
  url         String  @db.VarChar(500)
  size        Int?
  mimetype    String? @db.VarChar(100)
  description String? @db.VarChar(500)

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@map("attachments")
}

// ============================================================
// ACCOUNT SUBTYPE (for AR/AP/Tax aging & reporting)
// ============================================================
enum AccountSubtype {
  CASH
  BANK
  ACCOUNTS_RECEIVABLE
  ACCOUNTS_PAYABLE
  INVENTORY
  PREPAID
  FIXED_ASSET
  ACCUMULATED_DEPRECIATION
  TAX_PAYABLE
  TAX_RECEIVABLE
  SALARY_PAYABLE
  INSURANCE_PAYABLE
  RETAINED_EARNINGS
  RETAINAGE_RECEIVABLE
  RETAINAGE_PAYABLE
  ADVANCE_TO_SUPPLIER
  ADVANCE_FROM_CUSTOMER
  OTHER
}

model FixedAsset {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32)
  name        String  @db.VarChar(200)
  description String? @db.VarChar(500)

  acquisitionDate  DateTime @map("acquisition_date") @db.Date
  acquisitionCost  Decimal  @map("acquisition_cost") @db.Decimal(20, 2)
  residualValue    Decimal  @default(0) @map("residual_value") @db.Decimal(20, 2)
  usefulLifeMonths Int      @map("useful_life_months")

  depreciationMethod  DepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  monthlyDepreciation Decimal            @map("monthly_depreciation") @db.Decimal(20, 2)

  accumulatedDepreciation Decimal @default(0) @map("accumulated_depreciation") @db.Decimal(20, 2)
  bookValue               Decimal @default(0) @map("book_value") @db.Decimal(20, 2)

  status FixedAssetStatus @default(ACTIVE)

  assetAccountId String  @map("asset_account_id") @db.Uuid
  assetAccount   Account @relation("FixedAssetGL", fields: [assetAccountId], references: [id])

  depreciationAccountId String  @map("depreciation_account_id") @db.Uuid
  depreciationAccount   Account @relation("FixedAssetDeprecGL", fields: [depreciationAccountId], references: [id])

  accumulatedDeprecAccountId String  @map("accumulated_deprec_account_id") @db.Uuid
  accumulatedDeprecAccount   Account @relation("FixedAssetAccumGL", fields: [accumulatedDeprecAccountId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("FixedAssetProject", fields: [projectId], references: [id])

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation("FixedAssetCostCenter", fields: [costCenterId], references: [id])

  acquisitionJournalEntryId String?       @map("acquisition_journal_entry_id") @db.Uuid
  acquisitionJournalEntry   JournalEntry? @relation("FixedAssetAcquisitionJE", fields: [acquisitionJournalEntryId], references: [id])

  purchaseInvoiceItems PurchaseInvoiceItem[] @relation("PICapitalFixedAsset")

  disposalDate           DateTime?     @map("disposal_date") @db.Date
  disposalProceeds       Decimal?      @map("disposal_proceeds") @db.Decimal(20, 2)
  disposalJournalEntryId String?       @map("disposal_journal_entry_id") @db.Uuid
  disposalJournalEntry   JournalEntry? @relation("FixedAssetDisposalJE", fields: [disposalJournalEntryId], references: [id])

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  depreciationEntries DepreciationEntry[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([status])
  @@index([projectId])
  @@index([acquisitionDate])
  @@map("fixed_assets")
}

model DepreciationEntry {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(32)

  fixedAssetId String     @map("fixed_asset_id") @db.Uuid
  fixedAsset   FixedAsset @relation(fields: [fixedAssetId], references: [id], onDelete: Cascade)

  periodYear  Int      @map("period_year")
  periodMonth Int      @map("period_month")
  entryDate   DateTime @map("entry_date") @db.Date

  amount            Decimal @db.Decimal(20, 2)
  accumulatedBefore Decimal @map("accumulated_before") @db.Decimal(20, 2)
  accumulatedAfter  Decimal @map("accumulated_after") @db.Decimal(20, 2)
  bookValueAfter    Decimal @map("book_value_after") @db.Decimal(20, 2)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation("DepreciationEntryJE", fields: [journalEntryId], references: [id])

  createdById String? @map("created_by_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([fixedAssetId, periodYear, periodMonth])
  @@index([periodYear, periodMonth])
  @@map("depreciation_entries")
}

model PurchaseInvoice {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique @db.VarChar(32)
  invoiceNumber String    @map("invoice_number") @db.VarChar(64)
  invoiceDate   DateTime  @map("invoice_date") @db.Date
  dueDate       DateTime? @map("due_date") @db.Date

  supplierId String  @map("supplier_id") @db.Uuid
  supplier   Partner @relation("PurchaseInvoiceSupplier", fields: [supplierId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("PurchaseInvoiceProject", fields: [projectId], references: [id])

  poId String?        @map("po_id") @db.Uuid
  po   PurchaseOrder? @relation("PIFromPO", fields: [poId], references: [id])

  grId String?       @map("gr_id") @db.Uuid
  gr   GoodsReceipt? @relation("PIFromGR", fields: [grId], references: [id])

  subtotal       Decimal @default(0) @db.Decimal(20, 2)
  taxPercent     Decimal @default(9) @map("tax_percent") @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @map("tax_amount") @db.Decimal(20, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(20, 2)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(20, 2)
  paidAmount     Decimal @default(0) @map("paid_amount") @db.Decimal(20, 2)

  totalDiscount  Decimal @default(0) @map("total_discount") @db.Decimal(20, 2)
  totalAddition  Decimal @default(0) @map("total_addition") @db.Decimal(20, 2)
  totalDeduction Decimal @default(0) @map("total_deduction") @db.Decimal(20, 2)
  totalShipping  Decimal @default(0) @map("total_shipping") @db.Decimal(20, 2)
  totalLoading   Decimal @default(0) @map("total_loading") @db.Decimal(20, 2)

  status PurchaseInvoiceStatus @default(DRAFT)
  notes  String?               @db.VarChar(500)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation("PIJournal", fields: [journalEntryId], references: [id])

  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by") @db.Uuid

  createdById String? @map("created_by_id") @db.Uuid

  items    PurchaseInvoiceItem[]
  payments SupplierPayment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([supplierId])
  @@index([projectId])
  @@index([status])
  @@map("purchase_invoices")
