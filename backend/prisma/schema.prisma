enum InventoryCountStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
}

enum WarehouseTransferStatus {
  DRAFT
  IN_TRANSIT
  RECEIVED
  CANCELLED
}

model InventoryCount {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique @db.VarChar(32)
