  updatedAt    DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([projectId])
  @@index([type])
  @@map("technical_documents")
}

enum ChecklistType {
