// ============================================================
// SITE OPERATIONS (عملیات کارگاه)
// ============================================================

enum WeatherCondition {
  SUNNY
  CLOUDY
  RAINY
  SNOWY
  WINDY
  STORM
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  SICK
  HOLIDAY
}

enum EquipmentStatus {
  ACTIVE
  IDLE
  BROKEN
  MAINTENANCE
  RETIRED
}

model DailyReport {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(32)
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  reportDate DateTime @map("report_date") @db.Date

  startTime String?           @map("start_time") @db.VarChar(10)
  endTime   String?           @map("end_time") @db.VarChar(10)
  weather   WeatherCondition?
  tempMin   Int?              @map("temp_min")
  tempMax   Int?              @map("temp_max")

  // عملیات روزانه
  operations String? @db.Text
  issues     String? @db.Text
  incidents  String? @db.Text

  status ReportStatus @default(DRAFT)

  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workers     DailyReportWorker[]
  equipments  DailyReportEquipment[]
  materials   DailyReportMaterial[]
  progresses  DailyReportProgress[]
  requests    DailyReportRequest[]
  events      DailyReportEvent[]
  sections    DailyReportSection[]
  attachments DailyReportAttachment[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@unique([projectId, reportDate])
  @@index([reportDate])
  @@index([status])
  @@map("daily_reports")
}

// ============================================================
// DAILY REPORT SECTIONS — بخش‌های گزارش روزانه (تأیید بخشی)
// ============================================================

enum DailyReportSectionType {
  HEADER
  PROGRESS
  WORKERS
  EQUIPMENTS
  MATERIALS
  REQUESTS
  EVENTS
  ATTACHMENTS
}

enum DailyReportSectionStatus {
  PENDING
  APPROVED
  REJECTED
  FORWARDED
  FAILED
}

model DailyReportSection {
  id       String      @id @default(uuid()) @db.Uuid
  reportId String      @map("report_id") @db.Uuid
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  sectionType DailyReportSectionType   @map("section_type")
  status      DailyReportSectionStatus @default(PENDING)

  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  forwardedAt DateTime? @map("forwarded_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  forwardings DailyReportForwarding[]

  @@unique([reportId, sectionType])
  @@index([reportId])
  @@index([status])
  @@map("daily_report_sections")
}

// ============================================================
// DAILY REPORT FORWARDING — جلوگیری از ارسال دوباره
// ============================================================

enum ForwardingTarget {
  WAREHOUSE_RECEIPT
  WAREHOUSE_ISSUE
  PROCUREMENT_PR
  PETTY_CASH
  PAYROLL_ATTENDANCE
  EQUIPMENT_LOG
  PROGRESS_RECORD
  OTHER
}

model DailyReportForwarding {
  id        String             @id @default(uuid()) @db.Uuid
  sectionId String             @map("section_id") @db.Uuid
  section   DailyReportSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // کلید یکتا: reportId + sectionType + rowNumber + targetType
  reportId    String                 @map("report_id") @db.Uuid
  sectionType DailyReportSectionType @map("section_type")
  rowNumber   Int                    @map("row_number")
  targetType  ForwardingTarget       @map("target_type")

  // سند ساخته‌شده
  targetId    String? @map("target_id") @db.Uuid
  targetCode  String? @map("target_code") @db.VarChar(64)
  targetModel String? @map("target_model") @db.VarChar(64)

  status       String  @default("PENDING") @db.VarChar(20) // PENDING | SUCCESS | FAILED
  errorMessage String? @map("error_message") @db.VarChar(1000)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([reportId, sectionType, rowNumber, targetType])
  @@index([reportId])
  @@index([status])
  @@map("daily_report_forwardings")
}

// ============================================================
// DAILY REPORT ATTACHMENTS — پیوست‌های گزارش روزانه
// ============================================================

model DailyReportAttachment {
  id       String      @id @default(uuid()) @db.Uuid
  reportId String      @map("report_id") @db.Uuid
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  sectionType DailyReportSectionType? @map("section_type")
  rowNumber   Int?                    @map("row_number")

  filename    String  @db.VarChar(255)
  url         String  @db.VarChar(500)
  size        Int?
  mimetype    String? @db.VarChar(100)
  description String? @db.VarChar(500)

  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  uploadedAt   DateTime @default(now()) @map("uploaded_at")

  @@index([reportId])
  @@index([reportId, sectionType])
  @@map("daily_report_attachments")
}

model DailyReportWorker {
  id       String      @id @default(uuid()) @db.Uuid
  reportId String      @map("report_id") @db.Uuid
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  rowNumber Int    @map("row_number")
  teamName  String @map("team_name") @db.VarChar(200)

  // نوع: OWN (پرسنل خودمان) | CONTRACTOR (پرسنل پیمانکار)
  kind String @default("OWN") @db.VarChar(20)

  // اتصال به پیمانکار (برای پرسنل پیمانکار)
  contractorId   String?  @map("contractor_id") @db.Uuid
  contractor     Partner? @relation("WorkerContractor", fields: [contractorId], references: [id], onDelete: SetNull)
  contractorRate Decimal? @map("contractor_rate") @db.Decimal(20, 2)

  // اتصال به پرسنل خودمان (برای فوروارد به حضور و غیاب)
  employeeId  String?          @map("employee_id") @db.Uuid
  foreman     String?          @db.VarChar(200)
  workerCount Int              @map("worker_count")
  workHours   Decimal          @default(8) @map("work_hours") @db.Decimal(5, 2)
  overtime    Decimal          @default(0) @db.Decimal(5, 2)
  status      AttendanceStatus @default(PRESENT)
  wbsItemId   String?          @map("wbs_item_id") @db.Uuid
  description String?          @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("daily_report_workers")
}

model DailyReportEquipment {
  id       String      @id @default(uuid()) @db.Uuid
  reportId String      @map("report_id") @db.Uuid
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  rowNumber   Int             @map("row_number")
  equipmentId String?         @map("equipment_id") @db.Uuid
  equipment   Equipment?      @relation("DailyReportEquipmentLink", fields: [equipmentId], references: [id], onDelete: SetNull)
  name        String          @db.VarChar(200)
  plateNumber String?         @map("plate_number") @db.VarChar(32)
  operator    String?         @db.VarChar(200)
  hoursWorked Decimal         @default(0) @map("hours_worked") @db.Decimal(5, 2)
  status      EquipmentStatus @default(ACTIVE)

  // سوخت و توقف (طبق سند بخش ۱۵-۳ بند د)
  fuelLiters Decimal @default(0) @map("fuel_liters") @db.Decimal(10, 2)
  stopReason String? @map("stop_reason") @db.VarChar(500)

  // محل کار (WBS)
  wbsItemId String? @map("wbs_item_id") @db.Uuid

  description String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@index([wbsItemId])
  @@map("daily_report_equipments")
}

model DailyReportMaterial {
  id       String      @id @default(uuid()) @db.Uuid
  reportId String      @map("report_id") @db.Uuid
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  rowNumber Int    @map("row_number")
  itemName  String @map("item_name") @db.VarChar(300)

  // اتصال به کالا و انبار (برای فوروارد خودکار)
  itemId       String? @map("item_id") @db.Uuid
  warehouseId  String? @map("warehouse_id") @db.Uuid
  unit         String? @db.VarChar(32)
  quantity     Decimal @db.Decimal(20, 4)
  supplier     String? @db.VarChar(200)
  vehiclePlate String? @map("vehicle_plate") @db.VarChar(32)
  billNumber   String? @map("bill_number") @db.VarChar(64)
  movementType String? @map("movement_type") @db.VarChar(20)
  qcResult     String? @map("qc_result") @db.VarChar(20)
  exitType     String? @map("exit_type") @db.VarChar(30)
  exitDest     String? @map("exit_dest") @db.VarChar(200)
  description  String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("daily_report_materials")
}

model DailyReportProgress {
  id       String      @id @default(uuid()) @db.Uuid
  reportId String      @map("report_id") @db.Uuid
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  rowNumber   Int     @map("row_number")
  wbsItemId   String? @map("wbs_item_id") @db.Uuid
  description String  @db.VarChar(500)
  progressPct Decimal @map("progress_pct") @db.Decimal(5, 2)

  // مقدار انجام‌شده امروز (طبق سند بخش ۱۵-۳ بند ب)
  quantity Decimal? @db.Decimal(20, 4)
  unit     String?  @db.VarChar(32)

  // محل کار دقیق (بلوک، طبقه)
  location String? @db.VarChar(300)

  notes String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([reportId])
  @@map("daily_report_progresses")
}

