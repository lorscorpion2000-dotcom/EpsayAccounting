  itemId     String            @map("item_id") @db.Uuid
  item       Item              @relation("TransferItem", fields: [itemId], references: [id])
  rowNumber  Int               @map("row_number")
  quantity   Decimal           @db.Decimal(20, 4)
  unitCost   Decimal           @map("unit_cost") @db.Decimal(20, 2)
  totalCost  Decimal           @map("total_cost") @db.Decimal(24, 2)
  notes      String?           @db.VarChar(500)
  createdAt  DateTime          @default(now()) @map("created_at")

  @@index([transferId])
  @@map("warehouse_transfer_items")
}

// ============================================================
// ADJUSTMENT & MATERIAL PRICE DIFFERENCE (تعدیل و مابه‌التفاوت)
// ============================================================

enum AdjustmentStatus {
  DRAFT
  CONFIRMED
  POSTED
  CANCELLED
}

model AdjustmentIndex {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32)
  year        Int
  month       Int
  category    String   @db.VarChar(100)
  indexValue  Decimal  @map("index_value") @db.Decimal(20, 4)
  baseYear    Int      @map("base_year")
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@unique([year, month, category])
  @@index([category])
  @@map("adjustment_indices")
}

model AdjustmentCalculation {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32)
  projectId   String  @map("project_id") @db.Uuid
  project     Project @relation("AdjustmentProject", fields: [projectId], references: [id])
  contractId  String? @map("contract_id") @db.Uuid
  statementId String? @map("statement_id") @db.Uuid

  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date
  category   String   @db.VarChar(100)

  baseAmount     Decimal @map("base_amount") @db.Decimal(24, 2)
  baseIndex      Decimal @map("base_index") @db.Decimal(20, 4)
  currentIndex   Decimal @map("current_index") @db.Decimal(20, 4)
  coefficient    Decimal @db.Decimal(10, 4)
  adjustedAmount Decimal @map("adjusted_amount") @db.Decimal(24, 2)

  status         AdjustmentStatus @default(DRAFT)
  journalEntryId String?          @unique @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry?    @relation("AdjustmentJE", fields: [journalEntryId], references: [id], onDelete: SetNull)

  notes       String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([projectId])
  @@index([status])
  @@map("adjustment_calculations")
}

model MaterialPriceDiff {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(32)
  projectId   String  @map("project_id") @db.Uuid
  project     Project @relation("MPDProject", fields: [projectId], references: [id])
  contractId  String? @map("contract_id") @db.Uuid
  statementId String? @map("statement_id") @db.Uuid

  materialType String  @map("material_type") @db.VarChar(100)
  unit         String? @db.VarChar(32)
  quantity     Decimal @db.Decimal(20, 4)
  basePrice    Decimal @map("base_price") @db.Decimal(20, 2)
  actualPrice  Decimal @map("actual_price") @db.Decimal(20, 2)
  diffAmount   Decimal @map("diff_amount") @db.Decimal(24, 2)

  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date

  status         AdjustmentStatus @default(DRAFT)
  journalEntryId String?          @unique @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry?    @relation("MPDJE", fields: [journalEntryId], references: [id], onDelete: SetNull)

  notes       String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([projectId])
  @@index([materialType])
  @@index([status])
  @@map("material_price_diffs")
}

// ============================================================
// WORKER STATEMENT — صورت‌وضعیت پرسنل (حقوق و دستمزد)
// ============================================================

enum WorkerStatementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

model WorkerStatement {
  id     String                @id @default(uuid()) @db.Uuid
  code   String                @unique @db.VarChar(32)
  status WorkerStatementStatus @default(DRAFT)

  // پرسنل و قرارداد
  partnerId String  @map("partner_id") @db.Uuid
  partner   Partner @relation("WorkerStatementPartner", fields: [partnerId], references: [id])

  contractId String?        @map("contract_id")
  contract   LegalContract? @relation("WorkerStatementContractLink", fields: [contractId], references: [id], onDelete: SetNull)

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("WorkerStatementProject", fields: [projectId], references: [id])

  // دوره
  statementNumber Int      @map("statement_number")
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date

  // مبالغ دریافتی
  totalEarnings   Decimal @default(0) @map("total_earnings") @db.Decimal(24, 2)
  totalInsurance  Decimal @default(0) @map("total_insurance") @db.Decimal(24, 2)
  totalTax        Decimal @default(0) @map("total_tax") @db.Decimal(24, 2)
  totalDeductions Decimal @default(0) @map("total_deductions") @db.Decimal(24, 2)
  netPayable      Decimal @default(0) @map("net_payable") @db.Decimal(24, 2)

  // ضرایب
  insurancePercent Decimal @default(7) @map("insurance_percent") @db.Decimal(5, 2)

  // جمع کارکرد (خلاصه)
  workDays      Decimal @default(0) @map("work_days") @db.Decimal(6, 2)
  overtimeHours Decimal @default(0) @map("overtime_hours") @db.Decimal(7, 2)
  holidayHours  Decimal @default(0) @map("holiday_hours") @db.Decimal(7, 2)
  absentDays    Decimal @default(0) @map("absent_days") @db.Decimal(6, 2)
  leaveDays     Decimal @default(0) @map("leave_days") @db.Decimal(6, 2)

  description String? @db.VarChar(500)

  // workflow
  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  paidAt         DateTime? @map("paid_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items WorkerStatementItem[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@unique([partnerId, periodStart, periodEnd])
  @@index([status])
  @@index([partnerId])
  @@map("worker_statements")
}

model WorkerStatementItem {
  id          String          @id @default(uuid()) @db.Uuid
  statementId String          @map("statement_id") @db.Uuid
  statement   WorkerStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  rowNumber   Int
  description String  @db.VarChar(500)
  unit        String? @db.VarChar(32)
  quantity    Decimal @db.Decimal(20, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(20, 2)
  totalPrice  Decimal @map("total_price") @db.Decimal(24, 2)

  // برای اتصال به قرارداد
  contractItemId String? @map("contract_item_id")
  notes          String? @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([statementId])
  @@map("worker_statement_items")
}

// ============================================================
// PAYROLL TAX — جدول مالیات پله‌ای
// ============================================================

model PayrollTaxSetting {
  id    String @id @default(uuid()) @db.Uuid
  year  Int    @unique
  title String @default("") @db.VarChar(128)

  monthlyExemption         Decimal @default(0) @map("monthly_exemption") @db.Decimal(24, 2)
  insuranceEmployeePercent Decimal @default(7) @map("insurance_employee_percent") @db.Decimal(5, 2)
  insuranceEmployerPercent Decimal @default(23) @map("insurance_employer_percent") @db.Decimal(5, 2)

  isActive  Boolean  @default(true) @map("is_active")
  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brackets TaxBracket[]

  @@map("payroll_tax_settings")
}

model TaxBracket {
  id        String            @id @default(uuid()) @db.Uuid
  settingId String            @map("setting_id") @db.Uuid
  setting   PayrollTaxSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  order       Int      @default(0)
  fromAmount  Decimal  @map("from_amount") @db.Decimal(24, 2)
  toAmount    Decimal? @map("to_amount") @db.Decimal(24, 2)
  ratePercent Decimal  @map("rate_percent") @db.Decimal(5, 2)

  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([settingId, order])
  @@index([settingId])
  @@map("tax_brackets")
}

model Notification {
  id        String    @id @default(cuid())
  type      String
  severity  String    @default("INFO")
  title     String
  message   String
  entity    String
  entityId  String    @map("entity_id")
  link      String?
  dueDate   DateTime? @map("due_date") @db.Date
  daysLeft  Int?      @map("days_left")
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  userId    String?   @map("user_id") @db.Uuid
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([type, entity, entityId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model JournalDeletionLog {
  id              String    @id @default(cuid())
  journalId       String    @map("journal_id")
  journalNo       String?   @map("journal_no")
  journalDate     DateTime? @map("journal_date") @db.Date
  fiscalYearId    String?   @map("fiscal_year_id")
  status          String?
  description     String?
  totalDebit      Decimal?  @map("total_debit") @db.Decimal(18, 2)
  totalCredit     Decimal?  @map("total_credit") @db.Decimal(18, 2)
  linesSnapshot   Json?     @map("lines_snapshot")
  journalSnapshot Json?     @map("journal_snapshot")
  reason          String?
  deletedBy       String?   @map("deleted_by")
  deletedAt       DateTime  @default(now()) @map("deleted_at")
  ipAddress       String?   @map("ip_address")
  userAgent       String?   @map("user_agent")

  @@index([journalId])
  @@index([deletedAt])
  @@index([deletedBy])
  @@map("journal_deletion_logs")
}

// ═══════════════════════════════════════════════
// F15: Expense module
// ═══════════════════════════════════════════════

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum ExpensePayFromType {
  BANK
  CASH
  PETTY_CASH
}

model ExpenseCategory {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(32)
  name String @db.VarChar(200)

  parentId String?           @map("parent_id") @db.Uuid
  parent   ExpenseCategory?  @relation("ECParent", fields: [parentId], references: [id])
  children ExpenseCategory[] @relation("ECParent")

  accountId String?  @map("account_id") @db.Uuid
  account   Account? @relation("ExpenseCategoryAccount", fields: [accountId], references: [id])

  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  expenses Expense[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([parentId])
  @@index([isActive])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32)
  expenseDate DateTime @map("expense_date") @db.Date

  categoryId String          @map("category_id") @db.Uuid
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("ExpenseProject", fields: [projectId], references: [id])

  wbsItemId String?  @map("wbs_item_id") @db.Uuid
  wbsItem   WbsItem? @relation("ExpenseWbs", fields: [wbsItemId], references: [id])

  costCenterId String?     @map("cost_center_id") @db.Uuid
  costCenter   CostCenter? @relation("ExpenseCostCenter", fields: [costCenterId], references: [id])

  supplierId String?  @map("supplier_id") @db.Uuid
  supplier   Partner? @relation("ExpenseSupplier", fields: [supplierId], references: [id])

  amount      Decimal @db.Decimal(20, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(20, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(20, 2)

  description String @db.VarChar(500)

  payFromType      ExpensePayFromType @map("pay_from_type")
  payFromAccountId String             @map("pay_from_account_id") @db.Uuid
  payFromAccount   Account            @relation("ExpensePayFrom", fields: [payFromAccountId], references: [id])

  expenseAccountId String  @map("expense_account_id") @db.Uuid
  expenseAccount   Account @relation("ExpenseAccountDr", fields: [expenseAccountId], references: [id])

  status ExpenseStatus @default(DRAFT)

  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedBy     User?     @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedAt     DateTime? @map("approved_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)
  rejectedById   String?   @map("rejected_by_id") @db.Uuid
  rejectedAt     DateTime? @map("rejected_at")

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation("ExpenseJournal", fields: [journalEntryId], references: [id])

  attachmentUrl String? @map("attachment_url") @db.VarChar(500)
  invoiceNumber String? @map("invoice_number") @db.VarChar(64)
  notes         String? @db.VarChar(500)

  createdById String? @map("created_by_id") @db.Uuid
  createdBy   User?   @relation("ExpenseCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([status])
  @@index([projectId])
  @@index([categoryId])
  @@index([expenseDate])
  @@map("expenses")
}
