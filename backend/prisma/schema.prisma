  @@index([projectId])
  @@map("overhead_allocation_items")
}

// ============================================================
// CLIENT STATEMENT — صورت‌وضعیت کارفرما (۷ برگ)
// ============================================================

enum ClientStatementCategory {
  MATERIAL // خرید مصالح
  LABOR // اجرت و دستمزد
  MISC // هزینه‌های متفرقه
  TRANSPORT // کرایه حمل
  EQUIPMENT // ماشین آلات
}

enum ClientStatementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

model ClientStatement {
  id         String  @id @default(uuid()) @db.Uuid
  code       String  @unique @db.VarChar(32)
  projectId  String  @map("project_id") @db.Uuid
  project    Project @relation("ClientStatementProject", fields: [projectId], references: [id])
  contractId String? @map("contract_id") @db.Uuid

  statementNumber Int      @map("statement_number")
  periodStart     DateTime @map("period_start") @db.Date
  periodEnd       DateTime @map("period_end") @db.Date

  // ضرایب
  coefficient                Decimal @default(1.07) @db.Decimal(7, 4)
  contractorSharePercent     Decimal @default(7) @map("contractor_share_percent") @db.Decimal(5, 2)
  prepaymentDeductionPercent Decimal @default(20) @map("prepayment_deduction_percent") @db.Decimal(5, 2)

  // زیرجمع ۵ دسته
  subtotalMaterial  Decimal @default(0) @map("subtotal_material") @db.Decimal(24, 2)
  subtotalLabor     Decimal @default(0) @map("subtotal_labor") @db.Decimal(24, 2)
  subtotalMisc      Decimal @default(0) @map("subtotal_misc") @db.Decimal(24, 2)
  subtotalTransport Decimal @default(0) @map("subtotal_transport") @db.Decimal(24, 2)
  subtotalEquipment Decimal @default(0) @map("subtotal_equipment") @db.Decimal(24, 2)

  totalBeforeCoefficient    Decimal @default(0) @map("total_before_coefficient") @db.Decimal(24, 2)
  totalAfterCoefficient     Decimal @default(0) @map("total_after_coefficient") @db.Decimal(24, 2)
  contractorShareAmount     Decimal @default(0) @map("contractor_share_amount") @db.Decimal(24, 2)
  prepaymentDeductionAmount Decimal @default(0) @map("prepayment_deduction_amount") @db.Decimal(24, 2)
  netPayable                Decimal @default(0) @map("net_payable") @db.Decimal(24, 2)

  status ClientStatementStatus @default(DRAFT)

  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at")
  paidAt         DateTime? @map("paid_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  journalEntryId String?       @map("journal_entry_id") @db.Uuid
  journalEntry   JournalEntry? @relation("ClientStatementJE", fields: [journalEntryId], references: [id], onDelete: SetNull)

  description String? @db.VarChar(500)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items ClientStatementItem[]

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@unique([projectId, statementNumber])
  @@index([projectId])
  @@index([status])
  @@map("client_statements")
}

model ClientStatementItem {
  id          String          @id @default(uuid()) @db.Uuid
  statementId String          @map("statement_id") @db.Uuid
  statement   ClientStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  category      ClientStatementCategory
  rowNumber     Int                     @map("row_number")
  priceListCode String?                 @map("price_list_code") @db.VarChar(64)
  description   String                  @db.VarChar(500)
  unit          String?                 @db.VarChar(32)
  unitPrice     Decimal                 @map("unit_price") @db.Decimal(20, 2)
  quantity      Decimal                 @default(1) @db.Decimal(20, 4)
  totalPrice    Decimal                 @map("total_price") @db.Decimal(24, 2)
  itemDate      DateTime?               @map("item_date") @db.Date

  wbsItemId String?  @map("wbs_item_id") @db.Uuid
  wbsItem   WbsItem? @relation("ClientStatementItemWbs", fields: [wbsItemId], references: [id], onDelete: SetNull)

  notes     String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([statementId])
  @@index([category])
  @@map("client_statement_items")
}

