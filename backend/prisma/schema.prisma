// ============================================================

enum OverheadAllocationMethod {
  PERCENT_CONTRACT
  PERCENT_REVENUE
  MANUAL
}

enum OverheadAllocationStatus {
  DRAFT
  POSTED
  CANCELLED
}

model OverheadAllocation {
  id              String                   @id @default(uuid()) @db.Uuid
  code            String                   @unique @db.VarChar(32)
  fiscalYearId    String                   @map("fiscal_year_id") @db.Uuid
