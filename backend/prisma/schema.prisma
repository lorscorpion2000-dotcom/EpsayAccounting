  physicalQty    Decimal        @map("physical_qty") @db.Decimal(20, 4)
  difference     Decimal        @db.Decimal(20, 4)
  unitCost       Decimal        @map("unit_cost") @db.Decimal(20, 2)
  differenceCost Decimal        @map("difference_cost") @db.Decimal(24, 2)
  notes          String?        @db.VarChar(500)
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([countId])
  @@map("inventory_count_items")
}

model WarehouseTransfer {
  id              String                  @id @default(uuid()) @db.Uuid
  code            String                  @unique @db.VarChar(32)
  fromWarehouseId String                  @map("from_warehouse_id") @db.Uuid
  fromWarehouse   Warehouse               @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String                  @map("to_warehouse_id") @db.Uuid
  toWarehouse     Warehouse               @relation("TransferTo", fields: [toWarehouseId], references: [id])
  projectId       String?                 @map("project_id") @db.Uuid
  transferDate    DateTime                @map("transfer_date") @db.Date
  status          WarehouseTransferStatus @default(DRAFT)
  driverName      String?                 @map("driver_name") @db.VarChar(200)
  vehiclePlate    String?                 @map("vehicle_plate") @db.VarChar(32)
  notes           String?                 @db.VarChar(1000)
  sentAt          DateTime?               @map("sent_at")
  receivedAt      DateTime?               @map("received_at")
  receivedById    String?                 @map("received_by_id") @db.Uuid
  totalValue      Decimal                 @default(0) @map("total_value") @db.Decimal(24, 2)
  createdById     String?                 @map("created_by_id") @db.Uuid
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  items WarehouseTransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([status])
  @@map("warehouse_transfers")
  deletedAt     DateTime?
  deletedBy     String?
  deletedReason String?

  @@index([deletedAt])
  @@index([deletedBy])
}

model WarehouseTransferItem {
  id         String            @id @default(uuid()) @db.Uuid
  transferId String            @map("transfer_id") @db.Uuid
