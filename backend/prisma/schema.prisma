  MATERIALS
  SERVICES
  EQUIPMENT
  VEHICLE
  OTHER
}

enum CapitalTransactionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  CANCELLED
}

model ProjectPartnerShare {
  id        String  @id @default(uuid()) @db.Uuid
