  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([expiryDate])
  @@map("guarantees")
}

enum DocumentType {
  ARCHITECTURE
  STRUCTURE
  MEP
  SITE_PLAN
  OTHER
}

enum DocumentPhase {
  PHASE_1
  PHASE_2
  OTHER
}

model TechnicalDocument {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(32)
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type       DocumentType
  phase      DocumentPhase @default(PHASE_1)
  title      String        @db.VarChar(200)
  version    String        @db.VarChar(32)
  isApproved Boolean       @default(false) @map("is_approved")
  approvedAt DateTime?     @map("approved_at") @db.Date

  attachmentUrl String? @map("attachment_url") @db.VarChar(500)
  notes         String? @db.VarChar(500)

  uploadedById String?  @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([type])
  @@map("technical_documents")
}

enum ChecklistType {
  REBAR_BEFORE_CONCRETE
  FORMWORK
  ELECTRICAL
  PLUMBING
  WATERPROOFING
  OTHER
}

enum ChecklistStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model PhaseChecklist {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique @db.VarChar(32)
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  wbsItemId String? @map("wbs_item_id") @db.Uuid

  type          ChecklistType
  title         String          @db.VarChar(200)
  checklistDate DateTime        @map("checklist_date") @db.Date
  status        ChecklistStatus @default(DRAFT)

  items Json

  inspectorName  String? @map("inspector_name") @db.VarChar(200)
  supervisorName String? @map("supervisor_name") @db.VarChar(200)

  approvedById   String?   @map("approved_by_id") @db.Uuid
  approvedAt     DateTime? @map("approved_at") @db.Date
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  notes       String?  @db.VarChar(500)
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@index([checklistDate])
  @@map("phase_checklists")
}

// ═══════════════════════════════════════════════════════════════
//  ماول قراردادها (Legal Contracts)
// ═══════════════════════════════════════════════════════════════

enum LegalContractKind {
  WORKER_EMPLOYMENT
  CONTRACTOR_AGREEMENT
  CLIENT_CONTRACT
  SUBCONTRACTOR
}

enum LegalContractStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  COMPLETED
  CANCELLED
  TERMINATED
}

enum LegalContractPartyKind {
  INDIVIDUAL
  COMPANY
}

model LegalContractParty {
  id                 String                 @id @default(cuid())
  kind               LegalContractPartyKind @default(INDIVIDUAL)
  fullName           String
  fatherName         String?
  nationalId         String?                @unique
  economicCode       String?
  registrationNumber String?
  birthDate          DateTime?
  mobilePhone        String?
  landlinePhone      String?
  email              String?
  maritalStatus      MaritalStatus?
  childrenCount      Int?
  education          String?
  job                String?
  insuranceNumber    String?
  address            String?                @db.Text
  postalCode         String?
  bankName           String?
  bankAccount        String?
  bankSheba          String?
  notes              String?                @db.Text

  contracts LegalContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([nationalId])
}

model LegalContract {
  id     String              @id @default(cuid())
  code   String              @unique
  kind   LegalContractKind
  status LegalContractStatus @default(DRAFT)

  registrationNumber String?
  registrationDate   DateTime?

  partyId String
  party   LegalContractParty @relation(fields: [partyId], references: [id])

  projectId String?  @db.Uuid
  project   Project? @relation("ProjectLegalContracts", fields: [projectId], references: [id])

  title    String
  subject  String? @db.Text
  bodyHtml String? @db.Text

  totalAmount      Decimal? @db.Decimal(18, 0)
  salaryMonthly    Decimal? @db.Decimal(18, 0)
  salaryDaily      Decimal? @db.Decimal(18, 0)
  salaryHourly     Decimal? @db.Decimal(18, 0)
  workHoursPerWeek Int?

  startDate    DateTime?
  endDate      DateTime?
  durationText String?
  workLocation String?

  guaranteeType   String?
  guaranteeNumber String?
  guaranteeAmount Decimal? @db.Decimal(18, 0)
  guaranteeBank   String?

  supervisorName    String?
  companySignerName String?
  workerSignerName  String?

  notes String? @db.Text

  cancellationReason String?   @db.Text
  cancelledAt        DateTime?
  cancelledById      String?

  attachments LegalContractAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([kind])
  @@index([status])
  @@index([partyId])
  @@index([projectId])
}

model LegalContractAttachment {
  id         String        @id @default(cuid())
  contractId String
  contract   LegalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title      String
  fileUrl    String
  fileSize   Int?
  mimeType   String?
  createdAt  DateTime      @default(now())

  @@index([contractId])
}

model LegalContractTemplate {
  id        String            @id @default(cuid())
  kind      LegalContractKind @unique
  title     String
  bodyHtml  String            @db.Text
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

// ═══════════════════════════════════════════════════════════════
//  ماول فروش و پیشفروش (Sales)
// ═══════════════════════════════════════════════════════════════

enum SalesUnitStatus {
  AVAILABLE
  RESERVED
  SOLD
  DELIVERED
  CANCELLED
}

enum SalesPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

model SalesUnit {
  id        String  @id @default(cuid())
  projectId String  @db.Uuid
  project   Project @relation("ProjectSalesUnits", fields: [projectId], references: [id])

  unitNumber   String
  block        String?
  floor        Int?
  area         Decimal?        @db.Decimal(10, 2)
  bedrooms     Int?
  parkingCount Int?
  storageCount Int?
  listPrice    Decimal?        @db.Decimal(18, 0)
  status       SalesUnitStatus @default(AVAILABLE)
  notes        String?         @db.Text

  salesContracts SalesContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, unitNumber, block])
  @@index([projectId])
  @@index([status])
}

model SalesCustomer {
  id            String  @id @default(cuid())
  fullName      String
  nationalId    String? @unique
  mobilePhone   String?
  landlinePhone String?
  email         String?
  address       String? @db.Text
  postalCode    String?
  bankSheba     String?
  notes         String? @db.Text

  salesContracts SalesContract[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
}

model SalesContract {
  id     String              @id @default(cuid())
  code   String              @unique
  status LegalContractStatus @default(DRAFT)

  unitId String
  unit   SalesUnit @relation(fields: [unitId], references: [id])

  customerId String
  customer   SalesCustomer @relation(fields: [customerId], references: [id])

  totalPrice     Decimal  @db.Decimal(18, 0)
  discountAmount Decimal? @db.Decimal(18, 0)
  finalPrice     Decimal  @db.Decimal(18, 0)
  downPayment    Decimal? @db.Decimal(18, 0)

  contractDate DateTime
  deliveryDate DateTime?

  bodyHtml String? @db.Text
  notes    String? @db.Text

  cancellationReason String?   @db.Text
  cancelledAt        DateTime?

  installments SalesInstallment[]
  payments     SalesPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
  @@index([status])
  @@index([customerId])
  @@index([unitId])
}

model SalesInstallment {
  id         String        @id @default(cuid())
  contractId String
  contract   SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  sequence   Int
  dueDate    DateTime
  amount     Decimal            @db.Decimal(18, 0)
  paidAmount Decimal            @default(0) @db.Decimal(18, 0)
  status     SalesPaymentStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contractId])
  @@index([status])
}

model SalesPayment {
  id         String        @id @default(cuid())
  contractId String
  contract   SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  amount          Decimal  @db.Decimal(18, 0)
  paidAt          DateTime
  paymentMethod   String?
  referenceNumber String?
  bankName        String?
  notes           String?  @db.Text

  createdAt DateTime @default(now())

  @@index([contractId])
  @@index([paidAt])
}

// ═══════════════════════════════════════════════════════════════
//  پیوست‌های عمومی (چند فایل برای هر entity)
// ═══════════════════════════════════════════════════════════════

model Attachment {
  id         String @id @default(uuid()) @db.Uuid
  entityType String @map("entity_type") @db.VarChar(32)
  entityId   String @map("entity_id") @db.Uuid

  filename    String  @db.VarChar(255)
  url         String  @db.VarChar(500)
  size        Int?
  mimetype    String? @db.VarChar(100)
  description String? @db.VarChar(500)

  uploadedById String? @map("uploaded_by_id") @db.Uuid
  uploadedBy   User?   @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([uploadedById])
  @@map("attachments")
}
