  children        Decimal @default(0) @db.Decimal(20, 2)
  overtime        Decimal @default(0) @db.Decimal(20, 2)
  bonus           Decimal @default(0) @db.Decimal(20, 2)
  gross           Decimal @default(0) @db.Decimal(20, 2)
  insurance       Decimal @default(0) @db.Decimal(20, 2)
  tax             Decimal @default(0) @db.Decimal(20, 2)
  otherDeductions Decimal @default(0) @map("other_deductions") @db.Decimal(20, 2)
  netPay          Decimal @default(0) @map("net_pay") @db.Decimal(20, 2)

  workingDays   Int     @default(0) @map("working_days")
  overtimeHours Decimal @default(0) @map("overtime_hours") @db.Decimal(6, 2)

