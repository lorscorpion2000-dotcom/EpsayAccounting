// ============================================================
// EQUIPMENT & MACHINERY
// ============================================================

enum EquipmentOwnership {
  OWNED
  RENTED
}

enum MaintenanceType {
  PREVENTIVE
  REPAIR
  OVERHAUL
  TIRE
  OTHER
}

enum EquipmentLogStatus {
  DRAFT
  CONFIRMED
  POSTED
}

model Equipment {
  id           String             @id @default(uuid()) @db.Uuid
  code         String             @unique @db.VarChar(32)
  name         String             @db.VarChar(200)
  ownership    EquipmentOwnership @default(OWNED)
  category     String?            @db.VarChar(100)
  brand        String?            @db.VarChar(100)
  model        String?            @db.VarChar(100)
  year         Int?
  plateNumber  String?            @map("plate_number") @db.VarChar(32)
  serialNumber String?            @map("serial_number") @db.VarChar(64)

  hourlyRate  Decimal? @map("hourly_rate") @db.Decimal(20, 2)
  dailyRate   Decimal? @map("daily_rate") @db.Decimal(20, 2)
  monthlyRate Decimal? @map("monthly_rate") @db.Decimal(20, 2)

  fuelType        String?  @map("fuel_type") @db.VarChar(32)
  fuelNormPerHour Decimal? @map("fuel_norm_per_hour") @db.Decimal(10, 2)

  ownerId String?  @map("owner_id") @db.Uuid
  owner   Partner? @relation("EquipmentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  currentProjectId String?  @map("current_project_id") @db.Uuid
  currentProject   Project? @relation("EquipmentCurrentProject", fields: [currentProjectId], references: [id], onDelete: SetNull)

  status      EquipmentStatus @default(ACTIVE)
  isActive    Boolean         @default(true) @map("is_active")
  description String?         @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dailyLogs        EquipmentDailyLog[]
  maintenances     EquipmentMaintenance[]
  dailyReportLinks DailyReportEquipment[] @relation("DailyReportEquipmentLink")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@index([ownership])
  @@index([status])
  @@index([currentProjectId])
  @@map("equipment")
}

model EquipmentDailyLog {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(32)
  equipmentId String    @map("equipment_id") @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation("EquipmentLogProject", fields: [projectId], references: [id])
  wbsItemId String?  @map("wbs_item_id") @db.Uuid
  wbsItem   WbsItem? @relation("EquipmentLogWbs", fields: [wbsItemId], references: [id], onDelete: SetNull)

  logDate DateTime @map("log_date") @db.Date
  shift   String?  @db.VarChar(16)

  startMeter Decimal? @map("start_meter") @db.Decimal(12, 2)
  endMeter   Decimal? @map("end_meter") @db.Decimal(12, 2)

  workHours      Decimal @default(0) @map("work_hours") @db.Decimal(6, 2)
  idleHours      Decimal @default(0) @map("idle_hours") @db.Decimal(6, 2)
  stopHours      Decimal @default(0) @map("stop_hours") @db.Decimal(6, 2)
  breakdownHours Decimal @default(0) @map("breakdown_hours") @db.Decimal(6, 2)

  fuelLiters Decimal @default(0) @map("fuel_liters") @db.Decimal(10, 2)
  fuelCost   Decimal @default(0) @map("fuel_cost") @db.Decimal(20, 2)

  operatorId   String?  @map("operator_id") @db.Uuid
  operator     Partner? @relation("EquipmentLogOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  workLocation String?  @map("work_location") @db.VarChar(300)

  stopReason String? @map("stop_reason") @db.VarChar(500)
  notes      String? @db.VarChar(500)

  dailyReportId String? @map("daily_report_id") @db.Uuid

  computedCost Decimal            @default(0) @map("computed_cost") @db.Decimal(20, 2)
  status       EquipmentLogStatus @default(DRAFT)

  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by")

  @@unique([equipmentId, logDate, shift])
  @@index([logDate])
  @@index([projectId])
  @@index([status])
  @@map("equipment_daily_logs")
}

model EquipmentMaintenance {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(32)
  equipmentId String    @map("equipment_id") @db.Uuid
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  type            MaintenanceType @default(PREVENTIVE)
  maintenanceDate DateTime        @map("maintenance_date") @db.Date
  description     String          @db.VarChar(500)

  cost          Decimal @db.Decimal(20, 2)
  parts         Json?
  vendor        String? @db.VarChar(200)
  invoiceNumber String? @map("invoice_number") @db.VarChar(64)

