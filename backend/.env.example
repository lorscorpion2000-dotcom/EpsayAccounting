# ==============================================================
# پیکربندی متغیرهای محیطی سامانه حسابداری اپسای (Epsay Accounting)
# ==============================================================

PORT=3000
NODE_ENV=development

# آدرس اتصال به پایگاه‌داده PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/epsay_accounting?schema=public"

# کلید و تنظیمات توکن احراز هویت (JWT)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# کلیدهای امنیتی رمزنگاری داده‌ها و فایل‌های پشتیبان (حداقل ۳۲ بایت)
CONFIG_ENCRYPTION_KEY=replace-with-32-byte-hex-key-for-config-encryption
BACKUP_ENCRYPTION_KEY=replace-with-32-byte-hex-key-for-backup-encryption

# دامنه‌های مجاز دسترسی (CORS) - با کاما جدا شوند
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# تنظیمات پراکسی در محیط استقرار (در صورت استفاده از Nginx یا Cloudflare برابر با true یا 1)
TRUST_PROXY=false

# کنترل محدوده دسترسی نقش‌ها به پروژه‌ها (Project Scoping)
PROJECT_SCOPE_ENABLED=true

# تنظیمات آپلود و پیوست مدارک
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_REQUEST=10
