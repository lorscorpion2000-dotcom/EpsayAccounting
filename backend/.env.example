NODE_ENV=development
PORT=3000
API_PREFIX=api
APP_NAME=Epsay Accounting
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/epsay_accounting?schema=public"
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20
TIMEZONE=Asia/Tehran
DEFAULT_LOCALE=fa-IR
