+++ b/backend/src/modules/auth/auth.controller.spec.ts
@@ -0,0 +1,38 @@
+import { AuthController } from './auth.controller';
+
+// بررسی قرارداد متدهای حساس کنترلر Auth:
+// - تغییر رمز باید oldPassword را جدا به سرویس پاس بدهد (نه کل شیء DTO)
+// - verify2FA باید وجود داشته باشد و متد سرویس را با totpToken صدا بزند
+describe('AuthController (Contract)', () => {
+  let controller: AuthController;
+  let authService: any;
+
+  beforeEach(() => {
+    authService = {
+      login: jest.fn().mockResolvedValue({ accessToken: 'a', refreshToken: 'r' }),
+      changePassword: jest.fn().mockResolvedValue({ success: true }),
+      verify2FALogin: jest.fn().mockResolvedValue({ accessToken: 'a2', refreshToken: 'r2' }),
+      updatePreferences: jest.fn().mockResolvedValue({}),
+    };
+    controller = new AuthController(authService);
+  });
+
+  it('changePassword باید oldPassword و newPassword را به تفکیک به سرویس بدهد', async () => {
+    const dto = { oldPassword: 'old-pass-1234', newPassword: 'New-Strong-Pass@1404' } as any;
+    await controller.changePassword({ id: 'u1' } as any, dto);
+
+    expect(authService.changePassword).toHaveBeenCalledTimes(1);
+    expect(authService.changePassword).toHaveBeenCalledWith('u1', 'old-pass-1234', 'New-Strong-Pass@1404');
+    // مهم: نباید شیء پاس شود (باگ قبلی که bcrypt.compare را می‌شکست)
+    expect(typeof authService.changePassword.mock.calls[0][1]).toBe('string');
+    expect(typeof authService.changePassword.mock.calls[0][2]).toBe('string');
+  });
+
+  it('verify2FA اندپوینت ورود دو مرحله‌ای را صدا می‌زند', async () => {
+    const dto = { totpToken: 'pending-jwt', code: '123456' };
+    await controller.verify2FALogin(dto, {} as any);
+
+    expect(authService.verify2FALogin).toHaveBeenCalledTimes(1);
+    expect(authService.verify2FALogin).toHaveBeenCalledWith('pending-jwt', '123456', expect.any(Object));
+  });
+});
