+++ b/backend/src/modules/accounting/fiscal-closing.spec.ts
@@ -0,0 +1,42 @@
+import { Prisma } from '@prisma/client';
+import { FiscalYearsService } from './fiscal-years.service';
+
+const D = Prisma.Decimal;
+
+// سند اختتامیه باید با Decimal دقیق و متوازن باشد (مثال کلاسیک 0.1+0.2 در float).
+describe('FiscalYearsService.generateClosingEntry', () => {
+  it('جمع بدهکار = جمع بستانکار و سود به حساب انباشته منتقل می‌شود', async () => {
+    const created: any[] = [];
+    const tx: any = {
+      journalEntry: { findFirst: jest.fn().mockResolvedValue(null), create: jest.fn(async (a) => { created.push(a); return a.data; }) },
+      fiscalYear: { update: jest.fn().mockResolvedValue({ nextEntryNumber: 8 }) },
+    };
+    const prisma: any = {
+      journalEntry: { findFirst: jest.fn().mockResolvedValue(null) },
+      account: {
+        findFirst: jest.fn().mockResolvedValue({ id: 'ret', code: '3.3.1' }),
+        findMany: jest.fn().mockResolvedValue([
+          { id: 'rev', code: '4.1', name: 'درآمد' },
+          { id: 'exp1', code: '5.1', name: 'هزینه ۱' },
+          { id: 'exp2', code: '5.2', name: 'هزینه ۲' },
+        ]),
+      },
+      journalLine: {
+        groupBy: jest.fn().mockResolvedValue([
+          { accountId: 'rev', _sum: { debit: new D('0.00'), credit: new D('3000.00') } },
+          { accountId: 'exp1', _sum: { debit: new D('1000.10'), credit: new D('0.00') } },
+          { accountId: 'exp2', _sum: { debit: new D('500.20'), credit: new D('0.00') } },
+        ]),
+      },
+      $transaction: jest.fn(async (cb) => cb(tx)),
+    };
+    const svc = new FiscalYearsService(prisma);
+    await svc.generateClosingEntry('fy-1', 'user-1', 'سند اختتامیه');
+
+    expect(created.length).toBe(1);
+    const lines = created[0].data.lines.create;
+    const totalDr = lines.reduce((s: Prisma.Decimal, l: any) => s.plus(l.debit), new D(0));
+    const totalCr = lines.reduce((s: Prisma.Decimal, l: any) => s.plus(l.credit), new D(0));
+    expect(totalDr.toFixed(2)).toBe(totalCr.toFixed(2));
+  });
+});
